# ---------- TEC THA Follow-Up Engine — environment ----------
APP_ENV=production                      # development | test | production
PUBLIC_BASE_URL=https://app.example.in  # public URL; used in booking links, reset links and the webhook URL
DOMAIN=app.example.in                   # for the Caddy HTTPS proxy (docker compose --profile proxy)
WEB_PORT=3000

# Database (docker compose builds DATABASE_URL from these; set DATABASE_URL directly when running without Docker)
POSTGRES_DB=tectha
POSTGRES_USER=tectha
POSTGRES_PASSWORD=change-me-strong-db-password
# DATABASE_URL=postgresql+psycopg://tectha:password@localhost:5432/tectha

# Security
JWT_SECRET=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=true                      # true behind HTTPS (required in production)
# Encrypts WhatsApp access tokens at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ORIGINS=https://app.example.in
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30

# WhatsApp Business Platform (Cloud API) — one Meta app for the platform; each hospital saves its own
# phone number ID, business account ID and access token in the app (WhatsApp setup screen).
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_APP_SECRET=                    # Meta app → Settings → Basic → App secret (validates webhook signatures)
WHATSAPP_VERIFY_TOKEN=                  # any long random string; paste the same value in Meta's webhook setup
WHATSAPP_HTTP_TIMEOUT=15
ALLOW_UNSIGNED_WEBHOOKS=false           # never true in production

# Reminder engine
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_MINUTES=5,30,120
WORKER_INTERVAL_SECONDS=60
PROCESSING_STALE_MINUTES=10
ALLOW_DEMO_CLOCK=true                   # only affects hospitals flagged as demo

# Password-reset email (optional; without SMTP, admins set passwords from the Staff screen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.in
SMTP_STARTTLS=true

# CLI helpers (used once, then remove)
# ADMIN_PASSWORD=
# DEMO_PASSWORD=
